# Select the runnable comparisons. Remove any provider you do not have access to.
# Hosted Codex integrations require their own account setup and are documented separately.
DEMO_REVIEWERS=claude,copilot,opencode,openhands,github-aw

# Optional: defaults to the repository selected by gh in this checkout.
GITHUB_REPOSITORY=oraios/ai-review-comparison
# Optional: use the existing `gh auth login` session by leaving this empty.
# If supplied, use a human-owned token with repository/workflow/secret administration access.
# Never use a workflow GITHUB_TOKEN here: its label events do not trigger the router.
GH_TOKEN=

# Claude Pro/Max: sign in with Claude Code and run `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Copilot CLI + github-aw: personal fine-grained PAT with Copilot Requests permission.
# This is model authentication, separate from the repository administration login above.
COPILOT_GITHUB_TOKEN=
# OpenCode Go: subscription member key. Disable Extra Usage in the console.
OPENCODE_GO_API_KEY=
# Set an actual model ID available to your Go account, e.g. opencode-go/<model>.
OPENCODE_MODEL=
# OpenHands: explicitly funded provider API account; no subscription is assumed.
LLM_API_KEY=
OPENHANDS_MODEL=
