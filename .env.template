# Subscription-backed reviewers running inside the project image with Serena MCP.
DEMO_REVIEWERS=claude,copilot,opencode

# Optional. Blank uses this checkout's GitHub origin. Set OWNER/REPO to target another repository.
GITHUB_REPOSITORY=
# Optional: use the existing `gh auth login` session by leaving this empty.
# For a noninteractive run, use a repository administrator's personal token.
# Fine-grained repository permissions: Administration, Actions, Contents, Pull requests,
# Issues (labels), Secrets and Variables.
# Never use a workflow GITHUB_TOKEN here: comments and labels it creates do not trigger workflows.
GH_TOKEN=

# Claude Pro/Max: sign in with Claude Code and run `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Copilot CLI: personal fine-grained PAT with Copilot Requests permission.
# This is model authentication, separate from the repository administration login above.
COPILOT_GITHUB_TOKEN=
# OpenCode Go: subscription member key. Disable Extra Usage in the console.
OPENCODE_GO_API_KEY=
